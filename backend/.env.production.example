DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/transport_pro?schema=public"
JWT_SECRET="REEMPLAZAR_CON_SECRETO_ALEATORIO_MINIMO_32_CARACTERES"
OWNER_API_KEY="REEMPLAZAR_CON_API_KEY_ALEATORIA_MINIMO_32_CARACTERES"
PORT=4000
NODE_ENV=production

# Dominio real del frontend. No usar localhost ni comodines en produccion.
FRONTEND_URL="https://app.tudominio.cl"
CORS_ORIGINS="https://app.tudominio.cl"

MP_ENABLED=false
UPLOAD_DIR="/var/lib/transport-pro/uploads"
MAX_UPLOAD_MB=8

# Requerido si se habilitan correos transaccionales.
# RESEND_API_KEY=
# RESEND_FROM="Transport Pro <notifications@tudominio.cl>"
