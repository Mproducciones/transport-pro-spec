DATABASE_URL="postgresql://postgres:CLAVE@localhost:5432/transport_pro?schema=public"
JWT_SECRET="cambiar-en-produccion-minimo-32-caracteres"
OWNER_API_KEY="cambiar-en-produccion-minimo-32-caracteres"
PORT=4000
# Solo si la API no esta detras de ningun proxy (sin Vite/nginx): TRUST_PROXY_HOPS=0
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
# Lista separada por comas si hay mas de un origen permitido.
CORS_ORIGINS="http://localhost:5173"
# Si el frontend esta en otro dominio que la API (ej. Vercel + Render), usar true en produccion.
# CROSS_ORIGIN_COOKIES=false
MP_ENABLED=false
# Opcional: si está definida, el webhook de Mercado Pago exige la misma clave en la cabecera X-TP-Webhook-Token
# MP_WEBHOOK_SECRET=
# Límites por minuto (ver docs/SECURITY.md)
# API_RATE_LIMIT=200
# MUTATION_RATE_LIMIT=80
# AUTH_RATE_LIMIT=50
# HSTS: en production, false para desactivar el header HSTS
# HSTS=true
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=8
# Opcional: avisos al cliente cuando se aprueba/rechaza un pago (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM="Transport Pro <notifications@tudominio.com>"
