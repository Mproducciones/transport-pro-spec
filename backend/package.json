{
  "name": "transport-pro-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:critical": "tsx scripts/smoke-critical.ts",
    "smoke:billing": "tsx scripts/smoke-billing.ts",
    "smoke:shipment-rejection": "tsx scripts/smoke-shipment-rejection.ts",
    "smoke:customers-crud": "tsx scripts/smoke-customers-crud.ts",
    "verify:auth-roles": "tsx scripts/verify-auth-roles.ts",
    "verify:all": "npm run seed:test-agents && npm run test && npm run verify:auth-roles && npm run smoke:critical && npm run smoke:billing",
    "verify:tenant-isolation": "tsx scripts/verify-tenant-isolation.ts",
    "security:check": "tsx scripts/security-audit-surface.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "npm run test",
    "seed:multi-company": "tsx scripts/seed-multi-company.ts",
    "seed:clean-accounts": "tsx scripts/seed-clean-accounts.ts",
    "seed:large": "tsx scripts/seed-large.ts",
    "seed:shipment-demo": "tsx scripts/seed-shipment-demo.ts",
    "seed:demo-ui": "tsx scripts/seed-demo-ui.ts",
    "seed:today": "tsx scripts/seed-today-interactions.ts",
    "seed:test-agents": "tsx scripts/seed-test-agents.ts",
    "wipe:demo-operational": "tsx scripts/wipe-demo-operational.ts",
    "seed:admin-simulation": "tsx scripts/seed-admin-simulation.ts",
    "backfill:geo": "tsx scripts/backfill-geo.ts",
    "simulate:daily": "npm run seed:clean-accounts && npm run seed:test-agents && npm run seed:admin-simulation && npm run security:check && npm run verify:auth-roles && npm run verify:tenant-isolation && npm run smoke:critical && npm run smoke:billing",
    "qa:requested-users": "tsx scripts/qa-requested-users.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "prisma": "^7.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.1",
    "@types/pdfkit": "^0.17.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
