# Variables de entorno para Docker Compose
# COPIAR ESTE ARCHIVO a .env y REEMPLAZAR los valores con secretos reales

# Base de datos PostgreSQL
POSTGRES_USER=transport
POSTGRES_PASSWORD=GENERAR_CLAVE_SECRETA_AQUI_MINIMO_32_CARACTERES
POSTGRES_DB=transport_pro

# JWT - Generar claves de 64+ caracteres usando: openssl rand -base64 64
JWT_SECRET=GENERAR_CLAVE_SECRETA_JWT_AQUI_64_CARACTERES_MINIMO
JWT_REFRESH_SECRET=GENERAR_CLAVE_SECRETA_REFRESH_AQUI_64_CARACTERES_MINIMO

# API Key para SuperAdmin (Owner)
OWNER_API_KEY=GENERAR_CLAVE_SECRETA_OWNER_AQUI_64_CARACTERES_MINIMO

# URLs y CORS
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting (más restrictivo para producción)
API_RATE_LIMIT=100
MUTATION_RATE_LIMIT=50
AUTH_RATE_LIMIT=30

# Seguridad
HSTS=true
CROSS_ORIGIN_COOKIES=false
